# Firebase Configuration
EXPO_PUBLIC_FIREBASE_API_KEY=your_api_key_here
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=secret-santa-app-xxxx.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=secret-santa-app-xxxx
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=secret-santa-app-xxxx.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
EXPO_PUBLIC_FIREBASE_APP_ID=your_app_id

# Google OAuth Client IDs (from Firebase Console > Authentication > Sign-in method > Google)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your_web_client_id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your_ios_client_id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your_android_client_id.apps.googleusercontent.com

# App URLs
EXPO_PUBLIC_FIREBASE_HOSTING_URL=https://secret-santa-app-xxxx.web.app
