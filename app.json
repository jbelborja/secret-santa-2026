{
  "expo": {
    "name": "Secret Santa",
    "slug": "secret-santa",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": ["secretsanta", "com.googleusercontent.apps.553006398541-1g7111k3cg3ldsth2pi756bi9p9lpqsu"],
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#B91C1C"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.jbelborja.secretsanta",
      "googleServicesFile": "./GoogleService-Info.plist",
      "associatedDomains": [
        "applinks:secret-santa-2026-4f5f6.web.app"
      ]
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#B91C1C"
      },
      "package": "com.jbelborja.secretsanta",
      "googleServicesFile": "./google-services.json",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "secret-santa-2026-4f5f6.web.app",
              "pathPrefix": "/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ],
          "data": [
            {
              "scheme": "com.googleusercontent.apps.553006398541-1g7111k3cg3ldsth2pi756bi9p9lpqsu",
              "pathPrefix": "/oauth2redirect"
            }
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#B91C1C"
        }
      ],
      "expo-apple-authentication"
    ]
  }
}
