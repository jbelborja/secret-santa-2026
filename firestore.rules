rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Users profile collection
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Raffles collection
    match /raffles/{raffleId} {
      // Authenticated users can read raffles (needed for invite links and management)
      allow read: if request.auth != null;
      // Authenticated users can create raffles where they are manager
      allow create: if request.auth != null && request.resource.data.managerId == request.auth.uid;
      // Only the manager can update or delete their raffle
      allow update, delete: if request.auth != null && resource.data.managerId == request.auth.uid;
      
      // Participants subcollection
      match /participants/{participantId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && (
          get(/databases/$(database)/documents/raffles/$(raffleId)).data.managerId == request.auth.uid ||
          request.resource.data.userId == request.auth.uid
        );
        allow update: if request.auth != null && (
          // The raffle manager can update any participant
          get(/databases/$(database)/documents/raffles/$(raffleId)).data.managerId == request.auth.uid ||
          // The participant themselves can update their own document
          resource.data.get('userId', null) == request.auth.uid ||
          // An invited participant can claim an unclaimed invitation slot
          (resource.data.get('userId', null) == null && request.resource.data.userId == request.auth.uid) ||
          // Or matching email if pre-invited
          (resource.data.get('email', '') != '' && request.auth.token.email != null && resource.data.get('email', '') == request.auth.token.email && request.resource.data.userId == request.auth.uid)
        );
        allow delete: if request.auth != null && (
          get(/databases/$(database)/documents/raffles/$(raffleId)).data.managerId == request.auth.uid ||
          resource.data.get('userId', null) == request.auth.uid
        );
      }
    }

    // Collection group for participants (used by getRafflesIParticipateIn)
    match /{path=**}/participants/{participantId} {
      allow read: if request.auth != null && resource.data.get('userId', null) == request.auth.uid;
    }
  }
}
