rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Users profile collection
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Raffles collection
    match /raffles/{raffleId} {
      // Authenticated users can read raffles (needed for invite links and management)
      allow read: if request.auth != null;
      // Authenticated users can create raffles where they are manager
      allow create: if request.auth != null && request.resource.data.managerId == request.auth.uid;
      // Only the manager can update or delete their raffle
      allow update, delete: if request.auth != null && resource.data.managerId == request.auth.uid;
      
      // Participants subcollection
      match /participants/{participantId} {
        allow read: if request.auth != null;
        // Only the raffle manager can create participants (invitations)
        allow create: if request.auth != null &&
          get(/databases/$(database)/documents/raffles/$(raffleId)).data.managerId == request.auth.uid;
        allow update: if request.auth != null && (
          // The raffle manager can update any participant
          get(/databases/$(database)/documents/raffles/$(raffleId)).data.managerId == request.auth.uid ||
          // The participant themselves can update their own document
          resource.data.get('userId', null) == request.auth.uid ||
          // An invited participant can only claim an invitation if their email matches
          (
            request.auth.token.email != null &&
            resource.data.get('email', '') != '' &&
            (
              resource.data.get('email', '') == request.auth.token.email ||
              resource.data.get('email', '') == request.auth.token.email.lower()
            ) &&
            request.resource.data.userId == request.auth.uid
          )
        );
        allow delete: if request.auth != null && (
          get(/databases/$(database)/documents/raffles/$(raffleId)).data.managerId == request.auth.uid ||
          resource.data.get('userId', null) == request.auth.uid
        );
      }

      match /participants/{participantId}/suggestions/{suggestionId} {
        allow read: if request.auth != null &&
          get(/databases/$(database)/documents/raffles/$(raffleId)).data.status in ['drawn', 'completed'];
        allow create: if request.auth != null &&
          get(/databases/$(database)/documents/raffles/$(raffleId)).data.status in ['inviting', 'drawn'] &&
          get(/databases/$(database)/documents/raffles/$(raffleId)/participants/$(participantId)).data.status == 'accepted' &&
          request.resource.data.keys().hasAll(['fromParticipantId', 'text', 'createdAt']) &&
          request.resource.data.keys().hasOnly(['fromParticipantId', 'text', 'createdAt']) &&
          request.resource.data.fromParticipantId is string &&
          request.resource.data.fromParticipantId != participantId &&
          get(/databases/$(database)/documents/raffles/$(raffleId)/participants/$(request.resource.data.fromParticipantId)).data.userId == request.auth.uid &&
          get(/databases/$(database)/documents/raffles/$(raffleId)/participants/$(request.resource.data.fromParticipantId)).data.status == 'accepted' &&
          request.resource.data.text is string &&
          request.resource.data.text.size() > 0 &&
          request.resource.data.text.size() <= 2000 &&
          request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }

    // Collection group for participants (used by getRafflesIParticipateIn)
    match /{path=**}/participants/{participantId} {
      allow read: if request.auth != null && (
        resource.data.get('userId', null) == request.auth.uid ||
        (
          request.auth.token.email != null &&
          resource.data.get('email', '') != '' &&
          (
            resource.data.get('email', '') == request.auth.token.email ||
            resource.data.get('email', '') == request.auth.token.email.lower()
          )
        )
      );
    }
  }
}
